#include <winver.h>

1 ICON "assets/app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WinBatteryBar"
            VALUE "FileDescription",  "Windows 10 Taskbar BatteryBar & Network Speed Widget"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "WinBatteryBar"
            VALUE "OriginalFilename", "WinBatteryBar.exe"
            VALUE "ProductName",      "WinBatteryBar"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
